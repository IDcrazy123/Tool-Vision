# Generated by ToolVision install.sh. Re-run the installer to regenerate paths.
# User calibration remains in Tool-Vision/tool_vision.cfg outside this Git repo.

# Defining the base section also enables Update Manager on installations whose
# moonraker.conf does not already contain it. Duplicate sections in includes are
# merged by Moonraker.
[update_manager]

# The section name intentionally matches tool-vision.service. Moonraker only
# permits an extension updater to restart its matching service plus Klipper or
# Moonraker, so do not rename this section independently of the systemd unit.
[update_manager tool-vision]
type: git_repo
channel: dev
path: @REPO_DIR@
origin: @ORIGIN@
primary_branch: @PRIMARY_BRANCH@
virtualenv: @VIRTUALENV@
requirements: server/requirements.txt
managed_services: tool-vision klipper
info_tags:
  desc=ToolVision automatic XYZ tool-offset calibration
