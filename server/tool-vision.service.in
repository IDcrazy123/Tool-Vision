[Unit]
Description=Tool Vision native-resolution nozzle detection service
After=network-online.target crowsnest.service
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory="@PROJECT_DIR@"
Environment=PYTHONUNBUFFERED=1
ExecStart="@PYTHON@" -m server.app --host @HOST@ --port @PORT@ --log-dir "@LOG_DIR@"
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
UMask=0027

[Install]
WantedBy=multi-user.target
