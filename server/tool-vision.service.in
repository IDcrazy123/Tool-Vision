[Unit]
Description=Tool Vision native-resolution nozzle detection service
After=network-online.target crowsnest.service
Wants=network-online.target

[Service]
Type=simple
User=@USER@
# systemd path directives do not strip shell-style quotes on all supported
# MainsailOS/systemd releases. The installer uses a space-free runtime path.
WorkingDirectory=@PROJECT_DIR@
Environment=PYTHONUNBUFFERED=1
ExecStart="@PYTHON@" -m server.app --host @HOST@ --port @PORT@ --log-directory "@LOG_DIR@"
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
UMask=0027

[Install]
WantedBy=multi-user.target
